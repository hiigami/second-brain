{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "index-access",
  "description": "Operator authorization for whole approved-release visibility and a chosen index destination; domain membership and referral grants alone do not authorize indexing.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "information_domain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "project_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}},
    "output_path": {"type": "string", "minLength": 1},
    "authorized_by": {"type": "string", "minLength": 1},
    "authorized_at": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1}
  },
  "required": ["schema_version", "information_domain", "project_ids", "output_path", "authorized_by", "authorized_at", "reason"],
  "additionalProperties": false
}
