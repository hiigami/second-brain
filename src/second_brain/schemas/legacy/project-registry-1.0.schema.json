{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project-registry",
  "description": "Operator-maintained project names and routing hints. A shared domain does not grant disclosure or referral permission.",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "projects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "aliases": {"type": "array", "uniqueItems": true,
                      "items": {"type": "string", "minLength": 1, "maxLength": 120}},
          "information_domain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "owns_paths": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
                "pattern": {"type": "string", "minLength": 1}
              },
              "required": ["source_id", "pattern"],
              "additionalProperties": false
            }
          }
        },
        "required": ["id", "name", "aliases", "information_domain", "owns_paths"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "projects"],
  "additionalProperties": false
}
