{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "intake-link",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "item_id": {"type": "string", "pattern": "^INT-[a-f0-9]{24}$"},
    "target_run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "target_review_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(REQ|DEC|UNC|INV)-[0-9]{3,6}$"}},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1}
  },
  "required": ["schema_version", "item_id", "target_run_id", "target_review_sha256", "record_ids", "reviewer", "reviewed_at", "reason"],
  "additionalProperties": false
}
