{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "requirements",
              "architecture",
              "meetings",
              "sql",
              "repository"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "type",
          "path",
          "include",
          "exclude"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "global_exclude": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "approved": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path",
        "approved"
      ],
      "additionalProperties": false
    },
    "runs": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project",
    "sources",
    "global_exclude",
    "knowledge",
    "runs"
  ],
  "additionalProperties": false
}
