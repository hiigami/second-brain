{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "target_project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "project_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "run_path": {
      "type": "string",
      "minLength": 1
    },
    "release_path": {
      "type": "string",
      "minLength": 1
    },
    "copy_quotes": {
      "const": true
    },
    "copy_briefing": {
      "const": true
    },
    "retain_audit": {
      "const": true
    },
    "retention_reason": {
      "type": "string",
      "minLength": 1
    },
    "authorized_by": {
      "type": "string",
      "minLength": 1
    },
    "authorized_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "target_project_id",
    "run_id",
    "project_ids",
    "run_path",
    "release_path",
    "copy_quotes",
    "copy_briefing",
    "retain_audit",
    "retention_reason",
    "authorized_by",
    "authorized_at"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "context-permission"
}
