{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "referrals",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mentions_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assessments": {"type": "array", "items": {"type": "object", "properties": {
      "mention_id": {"type": "string", "pattern": "^M-[a-f0-9]{24}$"},
      "class": {"type": "string", "enum": ["R1", "R2", "R3", "R4"]},
      "disposition": {"type": "string", "enum": ["referred", "linked_home", "dismissed", "unresolved"]},
      "reason": {"type": "string", "minLength": 1},
      "home_record_ids": {"type": "array", "items": {"type": "string", "pattern": "^(REQ|DEC|UNC|INV)-[0-9]{3,6}$"}, "uniqueItems": true},
      "referral_id": {"anyOf": [{"type": "string", "pattern": "^REF-[0-9]{3,6}$"}, {"type": "null"}]}
    }, "required": ["mention_id", "class", "disposition", "reason", "home_record_ids", "referral_id"], "additionalProperties": false}},
    "referrals": {"type": "array", "items": {"type": "object", "properties": {
      "id": {"type": "string", "pattern": "^REF-[0-9]{3,6}$"},
      "target_project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
      "class": {"type": "string", "enum": ["R1", "R2", "R4"]},
      "source": {"type": "object", "properties": {
        "evidence_id": {"type": "string", "pattern": "^E-[a-f0-9]{24}$"},
        "segment_id": {"type": "string", "pattern": "^S-[a-f0-9]{24}$"},
        "representation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1}
      }, "required": ["evidence_id", "segment_id", "representation_sha256", "start_line", "end_line", "quote"], "additionalProperties": false},
      "summary": {"type": "string", "minLength": 1},
      "why_target_cares": {"type": "string", "minLength": 1},
      "home_record_ids": {"type": "array", "items": {"type": "string", "pattern": "^(REQ|DEC|UNC|INV)-[0-9]{3,6}$"}, "uniqueItems": true},
      "suggested_capture": {"type": "object", "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "relative_path": {"type": "string", "minLength": 1},
        "include_pattern": {"type": "string", "minLength": 1}
      }, "required": ["source_id", "relative_path", "include_pattern"], "additionalProperties": false},
      "disposition": {"const": "pending_target_review"}
    }, "required": ["id", "target_project_id", "class", "source", "summary", "why_target_cares", "home_record_ids", "suggested_capture", "disposition"], "additionalProperties": false}}
  },
  "required": ["schema_version", "project_id", "run_id", "registry_sha256", "mentions_sha256", "assessments", "referrals"],
  "additionalProperties": false
}
